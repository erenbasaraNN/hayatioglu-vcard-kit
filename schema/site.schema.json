{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Kartvizit ayarları",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "brand",
    "organization",
    "logo",
    "basePath"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "brand": {
      "type": "string",
      "minLength": 1
    },
    "organization": {
      "type": "string",
      "minLength": 1
    },
    "logo": {
      "type": "string",
      "minLength": 1
    },
    "website": {
      "type": "string",
      "pattern": "^https?://"
    },
    "basePath": {
      "type": "string",
      "pattern": "^/(?:[a-z0-9]+(?:-[a-z0-9]+)*(?:/[a-z0-9]+(?:-[a-z0-9]+)*)*)?$"
    }
  }
}
